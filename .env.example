# Smart Hospital SIEM - configuration template
# Copier ce fichier en .env et remplir les valeurs.
# NE JAMAIS committer .env dans git.

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=ChangeMe_StrongPassword

# --- SIEM Backend ---
JWT_SECRET_KEY=ChangeMe_Generate_At_Least_32_Random_Chars
SIEM_ADMIN_USER=admin
SIEM_ADMIN_PASSWORD=ChangeMe_StrongPassword

# --- Kafka / MQTT ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
MQTT_HOST=mosquitto
MQTT_PORT=1883

# --- URLs internes ---
LOKI_URL=http://loki:3100
MIMIR_URL=http://mimir:9009
TEMPO_OTLP_ENDPOINT=http://tempo:4317

# --- Telegram (creer un bot via @BotFather) ---
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=YOUR_CHAT_ID_HERE

# --- SMTP (Gmail recommande avec app password) ---
# 1. Activer 2FA sur Gmail
# 2. Generer un app password : https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@example.com
SMTP_PASSWORD=YOUR_APP_PASSWORD_HERE
SMTP_FROM=your.email@example.com
SMTP_TO=alerts@example.com

# --- Identification etablissement ---
HOSPITAL_NAME=CHU-Rabat
ENVIRONMENT=production
